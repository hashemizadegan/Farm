# Isolated yield preview: variable NAMES with safe placeholders only. Never put real values in this file or in git.
# Set real values in the PREVIEW Railway project's variables (never in the live project, melodious-liberation).
# Service wiring: infra/railway/preview/railway.ts. Runbook: docs/preview-runbook.md.
#
# Legend: [operator] generated by the operator, e.g. `openssl rand -base64 48`, and set once in the preview project
#         [railway]  provided by Railway (reference or platform-injected); do not set by hand
#         [fixed]    literal value defined in infra/railway/preview/railway.ts
#
# ── postgres ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<operator: random, >= 32 chars>              # [operator] consumed by postgres; referenced by DATABASE_URL

# ── api (and seed-runner, which builds the API in-process) ────────────────
APP_ENV=development                                             # [fixed] dev sign-in + simulation switches; refused openly deployed without the gate
DATABASE_URL=postgres://metafarm:<POSTGRES_PASSWORD>@postgres.railway.internal:5432/metafarm   # [railway] reference to the preview postgres
REDIS_URL=<reference to the preview redis>                      # [railway]
QUEUE_PREFIX=preview                                            # [fixed]
STORAGE_DRIVER=memory                                           # [fixed] no bucket in the preview
AUTH_PROVIDER=dev                                               # [fixed]
DEV_AUTH_SECRET=<operator: random, >= 32 chars>                 # [operator] api + seed-runner; the operator also uses it OFFLINE to mint dev tokens
PREVIEW_ACCESS_GATE=true                                        # [fixed] api: bearer-only except /healthz, /readyz, preflights
YIELD_WORKFLOW_ENABLED=true                                     # [fixed]
YIELD_CLAIM_INTENTS_ENABLED=true                                # [fixed] unsigned simulation intents only
REALTIME_EVENTS_ENABLED=true                                    # [fixed] api + worker: realtime channel (development only; refused when deployed)
INTEGRATION_SECRET_KEY=<operator: random, >= 32 chars>          # [operator] api; seed-runner by reference. Changing it invalidates every integration secret
CORS_ORIGINS=https://<preview web domain>                       # [operator] the preview web origin, after Railway generates it (api only)
# Never set in the preview: PARTY_LINKS_ENABLED, HOLDER_YIELD_ENABLED, TWIN_OWNERSHIP_INDEX_ENABLED, RWA_*, any signer,
# RPC, DAS, TRON or mainnet variable, OIDC_*, S3_*.

# ── web ───────────────────────────────────────────────────────────────────
# APP_ENV=development                                           # [fixed] (same name as above; set on web too)
NEXT_PUBLIC_API_URL=https://<preview api domain>                # [operator] preview API public URL (inlined at build time)
NEXT_PUBLIC_YIELD_PAGES_ENABLED=true                            # [fixed] build arg; the build refuses it for staging/production
NEXT_PUBLIC_REALTIME_URL=wss://<preview api domain>/v1/realtime # [operator] build arg; exact channel URL, no token or query (the build checks it)
# PREVIEW_ACCESS_GATE=true                                      # [fixed] (same name as above; set on web too)
PREVIEW_ACCESS_PASSWORD=<operator: random, >= 24 chars>         # [operator] web only; HTTP Basic user "preview"; share out of band

# ── seed-runner ───────────────────────────────────────────────────────────
# APP=seed-runner plus the api block above; DEV_AUTH_SECRET and INTEGRATION_SECRET_KEY are references to the api's
# values (in the IaC file). Restart policy: Never.

# ── worker and scheduler ──────────────────────────────────────────────────
# worker:    APP=worker, APP_ENV=development, DATABASE_URL, REDIS_URL, QUEUE_PREFIX=preview, STORAGE_DRIVER=memory,
#            REALTIME_EVENTS_ENABLED=true                        # [fixed]/[railway]; no chain, imagery, MQTT or bucket variable
# scheduler: APP=scheduler, APP_ENV=development, REDIS_URL, QUEUE_PREFIX=preview, REALTIME_RETENTION_CRON=17 * * * *

# ── operator workstation (not a service): smoke tests against the preview ─
# E2E_REMOTE=1
# E2E_WEB_URL=https://<preview web domain>
# E2E_API_URL=https://<preview api domain>
# E2E_PREVIEW_ACCESS_PASSWORD=<the preview PREVIEW_ACCESS_PASSWORD>
# DEV_AUTH_SECRET=<the preview DEV_AUTH_SECRET>                 # mints the test sign-in tokens locally
# Remote runs execute preview-gate.spec.ts, yield-operator.spec.ts and preview-journey.spec.ts (E2E_REMOTE_ALL=1 runs everything).
