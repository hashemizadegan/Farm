{
  "name": "@metafarm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev-token": "tsx --env-file-if-exists=../../.env src/scripts/dev-token.ts",
    "seed:yield": "tsx --env-file-if-exists=../../.env src/scripts/seed-yield-simulation.ts",
    "preview-seed": "tsx src/scripts/preview-seed-runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.840.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.2.0",
    "@metafarm/chain": "workspace:*",
    "@metafarm/config": "workspace:*",
    "@metafarm/contracts": "workspace:*",
    "@metafarm/db": "workspace:*",
    "@metafarm/domain": "workspace:*",
    "@metafarm/map-scene": "workspace:*",
    "@metafarm/observability": "workspace:*",
    "@metafarm/storage": "workspace:*",
    "bullmq": "^5.56.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "viem": "^2.31.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "yaml": "^2.8.0"
  }
}
