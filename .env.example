# Copy to .env for local development:  cp .env.example .env
# Values below are for the local docker-compose stack only. No real credentials.

APP_ENV=development
# Swagger UI at /docs. Unset: on in development, off in staging and production.
# API_DOCS_ENABLED=true
LOG_LEVEL=info

# ── Database (PostgreSQL 16 + PostGIS) ────────────────────────────────────
DATABASE_URL=postgres://metafarm:metafarm@localhost:5432/metafarm
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── Queue (Redis-compatible) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=metafarm

# ── Object storage (S3-compatible) ────────────────────────────────────────
# "memory" works offline for the API but uploads cannot actually be completed.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=metafarm-uploads
S3_ACCESS_KEY_ID=metafarm
S3_SECRET_ACCESS_KEY=metafarm-local-only
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=300
# direct = browser PUTs to a presigned bucket URL (bucket needs CORS); proxy = browser PUTs to the API.
UPLOAD_MODE=direct
# Signed-in users without a workspace may create one (and own it). Cap per user.
SELF_SERVE_WORKSPACES=true
MAX_OWNED_WORKSPACES=3
UPLOAD_MAX_BYTES=26214400

# ── Authentication ────────────────────────────────────────────────────────
# dev: HS256 tokens from `pnpm --filter @metafarm/api dev-token`. Refused in staging/production.
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# oidc: TODO(provider-config) set these for your identity provider.
# OIDC_ISSUER_URL=https://your-tenant.example-idp.com
# OIDC_AUDIENCE=metafarm-api
# OIDC_JWKS_URL=

# ── API server ────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# memory (per process, default) or redis (shared by all API replicas through REDIS_URL; fails open)
RATE_LIMIT_STORE=memory
# Bearer token for GET /metrics on the API and on the worker's HEALTH_PORT (32+ characters, a
# platform secret). Leave unset to keep the metrics endpoints off (404).
# METRICS_TOKEN=
TRUST_PROXY=true
# Comma-separated; list two during rotation. TODO(provider-config): one per webhook provider.
WEBHOOK_SIGNING_SECRETS=local-webhook-secret
WEBHOOK_TOLERANCE_SECONDS=300

# ── Wallet linking ────────────────────────────────────────────────────────
WALLET_AUTH_DOMAIN=localhost:3000
WALLET_AUTH_URI=http://localhost:3000
WALLET_NONCE_TTL_SECONDS=300
# J8: Solana player-wallet linking (/v1/me/player-wallets). Off by default; uses WALLET_AUTH_DOMAIN/URI
# and WALLET_NONCE_TTL_SECONDS for the signed message. Not related to RWA party wallets.
PLAYER_WALLETS_ENABLED=false

# ── Chain indexing (optional) ─────────────────────────────────────────────
# CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_CONFIRMATIONS=12
# NFT_ERC721_ADDRESS=
# NFT_ERC1155_ADDRESS=
# Scheduler: "0xaddress@fromBlock,..."
CHAIN_INDEX_CONTRACTS=

# ── Worker / scheduler ────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=2000
IMAGERY_PROVIDER=none
ALERT_EVALUATION_CRON=*/5 * * * *
CHAIN_INDEX_CRON=* * * * *
# Scheduled farm snapshots (off by default): set both to turn them on.
# TWIN_SNAPSHOT_CRON=17 * * * *
# TWIN_SNAPSHOTS_ENABLED=false
# Batch recorded snapshot commitments into one Merkle root per workspace (off by default, data only).
# TWIN_SNAPSHOT_BATCH_CRON=40 3 * * *
# TWIN_SNAPSHOT_BATCHES_ENABLED=false
# Ownership index (off by default, read-only): API reader, worker jobs (need an event source) and the sweep schedule.
# TWIN_OWNERSHIP_INDEX_ENABLED=false
# TWIN_OWNERSHIP_INDEX_CRON=*/10 * * * *
SCHEDULER_TZ=UTC

# ── Web (public, inlined at build time) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# TODO(provider-config): MapLibre style URL from your basemap provider; empty = offline mock map.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Space-separated hosts the map loads tiles/glyphs/sprites from (added to the CSP).
NEXT_PUBLIC_MAP_CONNECT_SRC=
# Origin the browser PUTs presigned uploads to (added to the CSP), e.g. the bucket's virtual-hosted URL.
NEXT_PUBLIC_UPLOAD_CONNECT_SRC=http://localhost:9000
NEXT_PUBLIC_CESIUM_ENABLED=false
# Show player-wallet linking on the account page (needs PLAYER_WALLETS_ENABLED on the API)
NEXT_PUBLIC_PLAYER_WALLETS_ENABLED=false

# Real-yield operator pages and simulation workflow (local development only; all off by default).
# `pnpm dev:yield` turns the three on for that run only; `pnpm seed:yield` adds three simulation cycles to the demo
# workspace. Production refuses YIELD_WORKFLOW_ENABLED; staging and production refuse the other two (packages/config,
# apps/web/next.config.ts).
# YIELD_WORKFLOW_ENABLED=false
# YIELD_CLAIM_INTENTS_ENABLED=false
# NEXT_PUBLIC_YIELD_PAGES_ENABLED=false
# Browser sign-in (OIDC Authorization Code + PKCE). Leave empty locally to use the dev token screen.
# Auth0 example: AUTHORITY=https://YOUR_TENANT.us.auth0.com  AUDIENCE=<the API identifier, same as OIDC_AUDIENCE>
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=

# ── Real-world asset rails (optional; off until set; testnets only) ─────
# RWA_SOLANA_RPC_URL=https://api.devnet.solana.com
# RWA_SOLANA_NETWORK=solana-devnet
# RWA_SOLANA_ISSUER=<the signer's public address>
# RWA_SOLANA_SIGNER_SECRET=<worker only; never commit a key>
# Compressed NFTs (registrations): a DAS-capable endpoint (worker) and the API's public URL (api).
# RWA_SOLANA_DAS_URL=https://<das-capable devnet endpoint>
# RWA_CNFT_TREE_CAPACITY=16384
# RWA_PREFLIGHT_ENABLED=false   # worker: read-only endpoint check while no signer is set
# RWA_CNFT_METADATA_BASE_URL=http://localhost:4000
