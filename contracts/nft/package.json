{
  "name": "@metafarm/nft-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Digital collectible contracts (ERC-721 / ERC-1155) and a harvest traceability registry. Not land title, crop ownership, profit share or an investment.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:harvest-registry": "hardhat run scripts/deploy-harvest-registry.ts --network target",
    "node": "hardhat node"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.0.0",
    "hardhat": "^2.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
